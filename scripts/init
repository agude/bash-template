#!/usr/bin/env bash
# Create a new project from this template. Run `scripts/init --help` for usage.
#
# The project comes from a committed ref through `git archive`, so changes
# that are not committed in this clone are not used, and the export-ignore
# entries in .gitattributes keep template-only files out. All work happens in
# a staging directory that is moved to <dest> only after every step succeeds.
#
# This script must run under Bash 3.2 with BSD, GNU, or BusyBox tools.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: scripts/init <dest> <name> [options]

Create a new Bash project at <dest> from this template. <name> names the
project and its command, such as my-tool.

Options:
  --ref REF    Template ref to copy. Default: origin/main, fetched first.
  -h, --help   Show this help.
EOF
}

die() {
    echo "init: $*" >&2
    exit 1
}

usage_error() {
    echo "init: $*" >&2
    echo "Run 'scripts/init --help' for usage." >&2
    exit 2
}

PLACEHOLDER="example-command"
# Any case variant of the placeholder, and any marker line, is a template
# defect once the substitution has run.
LEFTOVER_PATTERN='example[-_]command|init:[a-z]+-(begin|end)'
MARKER_PATTERN='init:[a-z]+-(begin|end)'

dest=""
name=""
ref="origin/main"

while [ $# -gt 0 ]; do
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        --ref)
            [ $# -ge 2 ] || usage_error "$1 needs a value"
            ref="$2"
            shift 2
            ;;
        -*)
            usage_error "unknown option: $1"
            ;;
        *)
            if [ -z "$dest" ]; then
                dest="$1"
            elif [ -z "$name" ]; then
                name="$1"
            else
                usage_error "unexpected argument: $1"
            fi
            shift
            ;;
    esac
done

if [ -z "$dest" ] || [ -z "$name" ]; then
    usage_error "<dest> and <name> are required"
fi

# Bash 3.2 treats a quoted right-hand side of =~ as a literal string, so the
# pattern lives in a variable.
name_pattern='^[a-z0-9]+(-[a-z0-9]+)*$'
[[ "$name" =~ $name_pattern ]] || die "name '$name' must match $name_pattern"
if printf '%s' "$name" | grep -qiE 'example[-_]command'; then
    die "name '$name' contains the template placeholder"
fi

case "$dest" in
    /*) ;;
    *) dest="$PWD/$dest" ;;
esac
dest_parent="$(dirname "$dest")"
[ -d "$dest_parent" ] || die "parent directory does not exist: $dest_parent"
if [ -e "$dest" ] || [ -L "$dest" ]; then
    die "destination already exists: $dest"
fi

command -v git >/dev/null 2>&1 || die "git is required"
command -v uv >/dev/null 2>&1 || die "uv is required"

template_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$template_root"

case "$ref" in
    origin/*)
        git fetch --quiet origin ||
            die "'git fetch origin' failed; pass --ref to copy a local ref instead"
        ;;
esac
commit="$(git rev-parse --verify --quiet "$ref^{commit}")" || die "unknown ref: $ref"
head="$(git rev-parse --verify --quiet HEAD || true)"
if [ "$head" != "$commit" ]; then
    echo "init: warning: copying $ref ($(git rev-parse --short "$commit")), not the checked-out HEAD" >&2
fi

# Stage next to <dest> so the final move is a rename on one file system.
stage_root="$(mktemp -d "$dest_parent/.init.XXXXXX")"
trap 'rm -rf "$stage_root"' EXIT
stage="$stage_root/project"
mkdir "$stage"

echo "init: copying $ref into a staging directory"
git archive --format=tar "$commit" | tar -x -f - -C "$stage"

# `git archive` exports each submodule as an empty directory. Record the URL,
# path, and pinned commit of each one so they can be added again below.
submodules=""
if [ -f "$stage/.gitmodules" ]; then
    path_keys="$(git config --file "$stage/.gitmodules" --name-only --get-regexp '^submodule\..*\.path$')"
    while IFS= read -r key; do
        [ -n "$key" ] || continue
        section="${key%.path}"
        path="$(git config --file "$stage/.gitmodules" --get "$key")"
        url="$(git config --file "$stage/.gitmodules" --get "$section.url")"
        pinned="$(git ls-tree "$commit" -- "$path" | awk '$2 == "commit" { print $3 }')"
        [ -n "$pinned" ] || die "no pinned commit for submodule $path at $ref"
        submodules="$submodules$path $url $pinned
"
    done <<EOF
$path_keys
EOF
    rm "$stage/.gitmodules"
fi

cd "$stage"
# Remove the submodule directories, and the directories of export-ignored
# files, such as scripts/ for scripts/init.
find . -mindepth 1 -type d -empty -delete

# grep exits 1 when nothing matches, which is not an error here. Only the
# options that BSD, GNU, and BusyBox grep share are used.
search() {
    local status=0
    grep "$@" || status=$?
    [ "$status" -le 1 ] || die "grep $* failed with status $status"
}

# Rewrite a file in place without `sed -i`, which differs between BSD and
# GNU. Writing back through `cat` keeps the file's mode, including +x.
rewrite() {
    local file="$1"
    shift
    "$@" <"$file" >"$stage_root/rewrite"
    cat "$stage_root/rewrite" >"$file"
}

# Remove the content of every template block, and its marker lines.
strip_markers() {
    awk -v file="$1" '
        match($0, /init:[a-z]+-begin/) {
            if (block != "") {
                printf "init: %s:%d: block %s starts inside block %s\n", file, NR, substr($0, RSTART + 5, RLENGTH - 11), block > "/dev/stderr"
                failed = 1
                exit
            }
            block = substr($0, RSTART + 5, RLENGTH - 11)
            if (block != "template") {
                printf "init: %s:%d: unknown block %s\n", file, NR, block > "/dev/stderr"
                failed = 1
                exit
            }
            next
        }
        match($0, /init:[a-z]+-end/) {
            name = substr($0, RSTART + 5, RLENGTH - 9)
            if (name != block) {
                printf "init: %s:%d: end of block %s does not match the open block\n", file, NR, name > "/dev/stderr"
                failed = 1
                exit
            }
            block = ""
            next
        }
        block == "" { print }
        END {
            if (!failed && block != "") {
                printf "init: %s: block %s is never closed\n", file, block > "/dev/stderr"
                failed = 1
            }
            exit failed
        }
    ' "$1"
}

# Lists of paths are read through here-documents rather than pipelines, so a
# failure inside a loop stops the script under `set -e`.
marked_files="$(search -rlE "$MARKER_PATTERN" .)"
while IFS= read -r file; do
    [ -n "$file" ] || continue
    rewrite "$file" strip_markers "$file"
done <<EOF
$marked_files
EOF

substitute() {
    sed -e "s/$PLACEHOLDER/$name/g"
}

# Rename paths that contain the placeholder, deepest first so a directory is
# renamed after its contents.
renamed_paths="$(find . -depth -name "*$PLACEHOLDER*")"
while IFS= read -r path; do
    [ -n "$path" ] || continue
    mv "$path" "$(dirname "$path")/$(basename "$path" | substitute)"
done <<EOF
$renamed_paths
EOF

# Keep uv.lock out of the substitution. `uv lock` renames the project's entry
# and keeps the entries sorted, which a text substitution would not.
mv uv.lock "$stage_root/uv.lock"
substituted_files="$(search -rl "$PLACEHOLDER" .)"
while IFS= read -r file; do
    [ -n "$file" ] || continue
    rewrite "$file" substitute
done <<EOF
$substituted_files
EOF

check_leftovers() {
    local contents names
    contents="$(search -rniE "$LEFTOVER_PATTERN" .)"
    names="$(find . -iname '*example[-_]command*')"
    if [ -n "$contents$names" ]; then
        printf '%s\n' "$contents" "$names" | grep -v '^$' >&2
        die "the template left placeholders or markers behind; fix the template"
    fi
}

check_leftovers
mv "$stage_root/uv.lock" uv.lock

# The template's lock is the starting point, so only the project's own entry
# changes.
echo "init: updating uv.lock"
uv lock --quiet
check_leftovers

git init --quiet --initial-branch=main
while read -r path url pinned; do
    [ -n "$path" ] || continue
    echo "init: adding submodule $path at $pinned"
    git submodule --quiet add "$url" "$path"
    (cd "$path" && git checkout --quiet "$pinned")
done <<EOF
$submodules
EOF
git add --all

cd "$template_root"
if [ -e "$dest" ] || [ -L "$dest" ]; then
    die "destination appeared while staging: $dest"
fi
mv "$stage" "$dest"

cat <<EOF
init: created $dest with the files staged and nothing committed. Next:

    cd $dest
    just sync && just hooks-install && just check
    git commit
EOF
